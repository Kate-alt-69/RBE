{
  "runtime": {
    "environment": "development",
    "workerThreads": 0,
    "gracefulShutdownTimeoutMs": 10000,
    "reclaimPort": true,
    "processRefreshHours": 500
  },
  "api": {
    "host": "0.0.0.0",
    "port": 8080,
    "requestTimeoutMs": 30000,
    "maxBodySizeBytes": 10485760
  },
  "security": {
    "corsAllowedOrigins": [
      "http://localhost:5173"
    ],
    "debugCorsOrigins": [
      "http://localhost:8080",
      "http://127.0.0.1:3000"
    ],
    "globalRateLimit": {
      "windowSecs": 30,
      "maxRequests": 90
    },
    "apiRateLimit": {
      "windowSecs": 60,
      "maxRequests": 120
    },
    "ipBan": {
      "strikeThreshold": 5,
      "strikeWindowSecs": 900,
      "banDurationSecs": 3600
    },
    "maxJsonPayloadBytes": 1048576,
    "cspPolicy": "default-src 'self'; script-src 'self' 'unsafe-inline'",
    "trustedProxyHeaders": false
  },
  "uac": {
    "sessionTtlMinutes": 1440,
    "requireEmailVerification": true,
    "oauthProviders": [
      "google"
    ]
  },
  "storage": {
    "driver": "sqlite",
    "sqlitePath": "./data/app.db",
    "supabaseSyncEnabled": false
  },
  "streaming": {
    "rtmpPort": 1935,
    "whipEnabled": false,
    "vodCacheDir": "./cache/vod"
  },
  "services": {
    "enabled": true,
    "directory": "service",
    "defaultMemoryLimitMb": 256,
    "startupTimeoutMs": 10000,
    "monitorIntervalMs": 1000,
    "maxRestartBackoffMs": 30000,
    "defaultIdleTimeoutMs": 300000
  },
  "videoManager": {
    "enabled": true,
    "dataDir": "data/video",
    "defaultDatabase": "default",
    "liveIdleSecs": 7200,
    "downloadMaxBytes": 8589934592
  },
  "containers": {
    "environments": 5,
    "swampsPerEnvironment": "auto",
    "workersPerSwamp": "auto",
    "warmPoolSize": 4,
    "maxConcurrent": 16,
    "defaultTimeoutMs": 5000,
    "memoryLimitMb": 256
  },
  "bootstrap": {
    "services": [
      "email"
    ]
  },
  "logging": {
    "level": "info",
    "format": "pretty"
  },
  "dashboards": {
    "enabled": true,
    "autoOpen": true,
    "adminPathPrefix": "/admin"
  }
}
